    {
      "parameters": {
        "jsCode": "const b=$json.body||$json; const approved=Boolean(b.approved); const creatorConfirmed=Boolean(b.creatorConfirmed); const videoUrl=String(b.videoUrl||'').trim(); const title=String(b.title||'').slice(0,2200); const privacy=String(b.privacy_level||'SELF_ONLY'); const isAigc=Boolean(b.is_aigc); const brandOrganic=b.brand_organic_toggle!==false; const hasCreds=Boolean($env.TIKTOK_ACCESS_TOKEN); const ready=approved&&creatorConfirmed&&hasCreds&&!!videoUrl; return [{json:{approved,creatorConfirmed,videoUrl,title,privacy,isAigc,brandOrganic,hasCreds,ready,approvalRequired:!approved,publishingBlocked:!ready}}];"
      },
