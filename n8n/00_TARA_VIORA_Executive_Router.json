{
  "name": "TARA VIORA — Executive Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tara-viora-command",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-command",
      "name": "Command Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body=$json.body||$json; const q=String(body.command||body.prompt||\"\").trim(); let route=\"content\", target=\"tara-viora-content\"; if(/فيديو|ريل|reel/i.test(q)){route=\"render\";target=\"tara-viora-render\";} else if(/سوق|منافس|بحث|داتا|صيدلي|عياد|b2b/i.test(q)){route=\"data\";target=\"tara-viora-data\";} else if(/واتساب|whatsapp/i.test(q)){route=\"whatsapp\";target=\"tara-viora-whatsapp\";} else if(/تحليل|نتائج|analytics/i.test(q)){route=\"analytics\";target=\"tara-viora-analytics\";} else if(/جدول|جدولة|موعد|schedule/i.test(q)){route=\"scheduler\";target=\"tara-viora-schedule\";} return [{json:{command:q,route,target,source:\"tara-viora\",requiresApproval:/نشر|صرف|ممولة|render|رندر|واتساب|whatsapp/i.test(q)}}];"
      },
      "id": "route-code",
      "name": "Route Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://tara-viora-n8n-production.up.railway.app/webhook/' + $json.target}}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({command:$json.command, source:$json.source, route:$json.route, requiresApproval:$json.requiresApproval}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "dispatch",
      "name": "Dispatch to Module",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const routed=$(\"Route Command\").first().json; return [{json:{ok:true,accepted:true,route:routed.route,target:routed.target,approvalRequired:routed.requiresApproval,moduleResult:$json}}];"
      },
      "id": "merge",
      "name": "Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        950,
        0
      ]
    }
  ],
